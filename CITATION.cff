    affiliation: "D. Serikbayev East Kazakhstan Technical University"
repository-code: "https://github.com/nurmukhametdaniyar/rapido"
license: "MIT OR Apache-2.0"
keywords:
  - anonymous authentication
  - anonymous credentials
  - BBS+
  - BLS12-381
  - threshold escrow
  - differential privacy
  - V2X
  - reference implementation
